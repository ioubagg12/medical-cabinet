# Copy this file to .env and fill in the values from
# Supabase dashboard > Project Settings > API Keys.
# .env is git-ignored. Never put the secret / service_role key here:
# everything in this file ends up in the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works.
VITE_SUPABASE_PUBLISHABLE_KEY=
